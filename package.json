{
  "name": "mediarr",
  "version": "0.6.26",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Scrapper1824/Mediarr.git"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web && npm run build -w server",
    "start": "node scripts/start.mjs",
    "console": "node server/dist/index.js",
    "tray": "wscript tray/Mediarr.vbs",
    "test": "npm test -w server",
    "reset-password": "node server/dist/resetPassword.js",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
